<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--FORM view-->
    <record id="contract_line_form_view" model="ir.ui.view">
        <field name="model">contract.line</field>
        <field name="inherit_id" ref="contract.contract_line_form_view" />
        <field name="arch" type="xml">
            <field name="analytic_distribution" position="before">
                <field
                    name="sale_order_line_id"
                    attrs="{'invisible': [('parent.contract_type', '!=', 'sale')]}"
                />
            </field>
        </field>
    </record>
</odoo>
